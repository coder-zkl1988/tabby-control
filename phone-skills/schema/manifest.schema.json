{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabby.local/schemas/phone-skill-manifest.schema.json",
  "title": "手机技能集合清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleVersion",
    "minAppVersion",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "bundleVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dir"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "dir": {
            "type": "string",
            "pattern": "^(?:system|oem|apps)/[a-z0-9][a-z0-9._/-]*$"
          }
        }
      }
    }
  }
}
