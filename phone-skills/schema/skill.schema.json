{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabby.local/schemas/phone-skill.schema.json",
  "title": "手机分层操作技能",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "version",
    "activation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "targetPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "enum": [
        "system",
        "oem",
        "app"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "type": "integer"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intents",
        "taskKeywords",
        "packages",
        "manufacturers",
        "androidApiMin",
        "taskScoped",
        "surfaceScoped"
      ],
      "properties": {
        "intents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "taskKeywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manufacturers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "androidApiMin": {
          "type": "integer",
          "minimum": 1
        },
        "taskScoped": {
          "type": "boolean"
        },
        "surfaceScoped": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "steps"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observe",
                "action"
              ],
              "properties": {
                "observe": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "subskills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "file",
          "keywords"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^references/[a-z0-9][a-z0-9._/-]*\\.md$"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority": {
            "type": "integer"
          },
          "requiresCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
