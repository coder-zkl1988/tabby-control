{
  "name": "@youngclaw/tabby-control",
  "version": "2026.3.7",
  "description": "Remote Android device control plugin for Tabby. Manages WebSocket connections with Tababy Android app and exposes device control as tools.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./protocol": {
      "import": "./dist/protocol.js",
      "types": "./dist/protocol.d.ts"
    },
    "./ws-server": {
      "import": "./dist/ws-server.js",
      "types": "./dist/ws-server.d.ts"
    },
    "./task-coordinator": {
      "import": "./dist/task-coordinator.js",
      "types": "./dist/task-coordinator.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge.js",
      "types": "./dist/bridge.d.ts"
    }
  },
  "files": [
    "dist",
    "generated",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "phone-skills:build": "node scripts/build-phone-skills.mjs",
    "phone-skills:check": "node scripts/build-phone-skills.mjs --check",
    "release-gate:device": "node scripts/run-device-release-gate.mjs",
    "loadtest:fleet": "node scripts/fleet-load-test.mjs",
    "prebuild": "npm run phone-skills:build",
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "build:nexu": "node scripts/build-nexu.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "keywords": [
    "tabby",
    "tabby-plugin",
    "android",
    "device-control",
    "websocket"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  }
}
